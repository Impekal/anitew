// Cloudflare Workers + Static Assets — Backlog A7.
//
// Die App bleibt local-first und ohne ANITEW-Konto oder Nutzerdatenbank.
// Servercode läuft nur für ausdrücklich gewählte Infrastruktur: Google OAuth
// und Web Push. Push speichert ausschließlich die technische Push-Adresse,
// die gewählte Zeit/Zeitzone und generische Erinnerungstexte — niemals
// Trainings-, Gedächtnis-, Profil- oder Sicherungsinhalte.
{
  "name": "anitew",
  "compatibility_date": "2026-08-23",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/oauth/google/*", "/push/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PUSH_REMINDERS",
        "class_name": "PushReminder"
      }
    ]
  },
  "exports": {
    "PushReminder": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
