// Cloudflare Workers + Static Assets — Backlog A7.
//
// Die App bleibt local-first und ohne ANITEW-Konto oder Nutzerdatenbank.
// Servercode läuft ausschließlich für den Google-OAuth-Handschlag: Google
// liefert den Autorisierungscode an /oauth/google/*, der Worker tauscht ihn
// gegen Tokens und hält die verschlüsselte Sitzung nur im Browser-Cookie.
// Trainings-, Erinnerungs- und Sicherungsdaten werden nicht serverseitig
// gespeichert und laufen weiterhin direkt zwischen Gerät und eigenem Drive.
{
  "name": "anitew",
  "compatibility_date": "2026-08-23",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/oauth/google/*"]
  }
}
